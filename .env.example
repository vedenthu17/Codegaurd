# CodeGuard needs no API keys of any kind (no LLM, no external services).
PORT=8000
WORKERS=2
# Request body cap and batch size for /analyze and /analyze/batch
CODEGUARD_MAX_BODY_BYTES=2097152
CODEGUARD_MAX_BATCH=1000
# Used by HttpChecker / demo --url when the guard talks to a remote service
CODEGUARD_URL=http://127.0.0.1:8000
